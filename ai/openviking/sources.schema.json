{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kafka committed-document OpenViking source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "namespace", "repositories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "namespace": { "const": "viking://resources/kafka-git" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "include", "exclude"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "root": { "type": "string", "minLength": 1 },
          "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
